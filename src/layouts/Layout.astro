---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsChoices from '../components/AnalyticsChoices.astro';
import metadata from '../data/page-meta.json';
interface Props { page: keyof typeof metadata; }
const {page}=Astro.props;
const data=metadata[page];
const production=import.meta.env.PROD && import.meta.env.PUBLIC_SITE_ENV==='production';
const head=production?data.head:data.head.replace(/(name="robots"\s+content=")[^"]*/, '$1noindex, nofollow, noarchive');
---
<!doctype html>
<html lang="en-US"><head><Fragment set:html={head}/><script is:inline src="/js/analytics.js" defer></script></head>
<body class={data.bodyClass}><a class="skip-link" href="#main-content">Skip to main content</a><Header/><slot/>
<AnalyticsChoices enableAnalytics={production}/><Footer/>
<script is:inline src="/js/main.js" defer></script>
{page==='contact' && <script is:inline src="/js/contact-form.js" defer></script>}
{page==='thank-you' && <script is:inline src="/js/contact-conversion.js" defer></script>}
</body></html>
