---
import Layout from '../layouts/Layout.astro';
---
<Layout page="thank-you">
<main id="main-content">
<section class="thank-you-hero">
<div class="container">
<p class="section-kicker">
Message Received
</p>
<h1>
Thank you.
</h1>
<p class="hero-lead">
Your message has been successfully submitted to RGE Solutions.
</p>
<p>
We personally review every inquiry.
If your message requires a response, we'll typically reply within one
business day.
</p>
</div>
</section>
<section class="section">
<div class="container">
<div class="thank-you-grid">
<div class="section-card">
<h2>
What happens next?
</h2>
<ul>
<li>
Your inquiry has been received.
</li>
<li>
We'll review your message.
</li>
<li>
If additional information is needed, we'll contact you.
</li>
<li>
If appropriate, we'll schedule an introductory conversation.
</li>
</ul>
</div>
<div class="section-card">
<h2>
While you're here...
</h2>
<p>
Learn more about RGE Solutions and our technology advisory services.
</p>
<p>
<a
class="button primary"
href="/">
Return Home
</a>
</p>
<p>
<a
class="button secondary"
href="/contact">
Send Another Message
</a>
</p>
</div>
</div>
</div>
</section>
</main>
</Layout>
